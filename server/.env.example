# Neon pooled connection string. Never add this value to the iOS app.
# Keep TLS certificate verification enabled (sslmode=verify-full).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER.neon.tech/neondb?sslmode=verify-full
PUBLIC_URL=https://api.example.com
PORT=8787
HOST=0.0.0.0
# Optional, once the app has an App Store listing:
APP_STORE_URL=
# For a self-contained local Postgres development server instead of Neon:
# DATABASE_URL=pglite://.data/local
# PUBLIC_URL=http://localhost:8787
# HOST=127.0.0.1
